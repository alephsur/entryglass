# Copy this file to .env at the repository root. Never commit .env.
# No API key is needed to run the scaffold.
ENTRYGLASS_ENVIRONMENT=development
ENTRYGLASS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ENTRYGLASS_DATABASE_PATH=data/entryglass.sqlite3
ENTRYGLASS_NANSEN_TIMEOUT_SECONDS=20
ENTRYGLASS_NANSEN_MAX_CONCURRENCY=1
ENTRYGLASS_REVIEW_MAX_ENTRIES=5
ENTRYGLASS_REVIEW_MAX_REQUESTS=15
ENTRYGLASS_REVIEW_MAX_CREDITS=32

# Used by explicit validation/import commands and by a review started in the UI.
# Health checks and ordinary tests never use it. A UI review can spend credits up
# to the server-side ceilings above; the key is never exposed to the browser.
# Do not create a VITE_NANSEN_API_KEY or put this key in frontend code.
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai
