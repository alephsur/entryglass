# Copy this file to .env at the repository root. Never commit .env.
# No API key is needed to run the scaffold.
ENTRYGLASS_ENVIRONMENT=development
ENTRYGLASS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Used only by the explicit, opt-in server-side provider validation command.
# The app, health endpoint, and ordinary test suite do not require this key.
# Do not create a VITE_NANSEN_API_KEY or put this key in frontend code.
NANSEN_API_KEY=
NANSEN_BASE_URL=https://api.nansen.ai
